{
  "expo": {
    "name": "UberClone",
    "slug": "UberClone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación requiere acceso a tu ubicación en tiempo real para mostrar tu posición en el mapa y asignarte viajes cercanos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Esta aplicación requiere acceso a tu ubicación para conectarte con pasajeros."
        }
      ],
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
